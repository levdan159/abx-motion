	(text "+24V_BRAKE: LMR36520FADDA buck from +BATT. Vout = 1.0 V x (1 + R501/R502) = 24.1 V (12 V coils: R502 = 9.09k)."
		(exclude_from_sim no)
		(at 25.4 33.02 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "e760001b-381a-5bb0-967a-edaaec9e7f74")
	)
	(text "Coil ENERGISED (brake released) only while BRAKEn_EN = 1 AND +3V3_DRV_EN (E-stop) = 1. High-side switched: a coil wire shorted to chassis cannot release the brake."
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "e865d1d6-9f43-57c8-bcf6-4b00c438999b")
	)
	(text "TPS27S100A: current limit 1.5 A (R508/R509 = 1.233 V x 2000 / 1.5 A), <1 us hard-short trip, thermal shutdown; FLT (open drain, wired-OR) -> BRK_FLT_N -> PCA9555 IO1_3."
		(exclude_from_sim no)
		(at 25.4 43.18 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "5dae0574-c4da-539c-8906-5c6c6c76a34a")
	)
