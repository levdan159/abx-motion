	(text "SENSORS: GPS + 9-DoF IMU headers (modules are off-board)"
		(exclude_from_sim no)
		(at 30 30 0)
		(effects (font (size 2 2)) (justify left bottom))
		(uuid "ed18905d-bdd2-439c-925e-73ab93d9352a")
	)
	(text "GPS (J210): u-blox class module on ESP32 UART1, 115200 8N1; PPS to GPIO. Pin 4 = module TX, pin 5 = module RX. Powered from +5V or +3V3 per module."
		(exclude_from_sim no)
		(at 30 40 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "c954dd4c-b655-4fb1-8695-f841174f43c9")
	)
	(text "IMU (J211): 9-DoF breakout (BNO085 / ICM-20948 class) on the shared I2C bus; INT and RST to GPIO. Pull-ups live on the MCU sheet."
		(exclude_from_sim no)
		(at 30 46 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "4e4164d3-fc5b-4217-a019-5b503919a994")
	)
	(text "Mount the IMU away from the motors, battery and power wiring: the magnetometer reads their fields. Use GPS course over ground as a heading cross-check."
