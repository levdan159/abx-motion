	(text "ESC CHANNEL - one brushless motor (36 V 10S pack, 30 A peak). STM32F405 + DRV8323S, VESC-firmware compatible pinout (hw_hd60 style)"
		(exclude_from_sim no)
		(at 20 20 0)
		(effects (font (size 3.5 3.5) (bold yes)) (justify left bottom))
		(uuid "b8faabe0-efa6-54ed-aa4a-30a32d48978b")
	)
	(text "Instanced twice in the root: ESC_Motor_1 (refs 3xx) and ESC_Motor_2 (refs 4xx). VBUS = battery bus after the main connector (no fuse/TVS here: see notes)."
		(exclude_from_sim no)
		(at 20 28 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "eb989d04-f100-5ace-9221-226365e8334f")
	)
	(text "MCU: STM32F405RGT6"
		(exclude_from_sim no)
		(at 20 105 0)
		(effects (font (size 2.5 2.5) (bold yes)) (justify left bottom))
		(uuid "e2d58f25-4f6f-5a09-85e1-04c8bda24112")
	)
	(text "GATE DRIVER: DRV8323S (SPI mode, 3 CSAs)"
		(exclude_from_sim no)
		(at 190 95 0)
		(effects (font (size 2.5 2.5) (bold yes)) (justify left bottom))
		(uuid "62463682-e891-54bd-8ccb-8a9d2de0f98c")
	)
	(text "POWER STAGE: 3 half-bridges, CSD19532Q5B 100 V, 1 mOhm shunts (route SPx/GND as Kelvin pair to the DRV8323S)"
		(exclude_from_sim no)
		(at 335 95 0)
		(effects (font (size 2.5 2.5) (bold yes)) (justify left bottom))
		(uuid "5f649a4d-53f4-5cbf-b812-e078839bc39f")
	)
	(text "SENSING: phase voltages, VBUS, PCB NTC, motor NTC"
		(exclude_from_sim no)
		(at 290 280 0)
		(effects (font (size 2.5 2.5) (bold yes)) (justify left bottom))
		(uuid "7fe605bc-36be-5b9c-8555-67c183011e87")
	)
	(text "3V3 SUPPLY + HARDWARE E-STOP GATE (ENABLE = MCU AND +3V3_DRV_EN)"
		(exclude_from_sim no)
		(at 140 322 0)
		(effects (font (size 2.5 2.5) (bold yes)) (justify left bottom))
		(uuid "6fcc2483-e678-5738-812c-30beea2df754")
	)
	(text "CAN TO ESP32 (internal bus)"
		(exclude_from_sim no)
		(at 335 322 0)
		(effects (font (size 2.5 2.5) (bold yes)) (justify left bottom))
		(uuid "f369dc0d-f8f9-57c3-a809-facbaba64524")
	)
	(text "MOTOR INTERFACE"
		(exclude_from_sim no)
		(at 430 322 0)
		(effects (font (size 2.5 2.5) (bold yes)) (justify left bottom))
		(uuid "ca26ca4b-59e6-52a3-92a6-7f7931c400b2")
	)
	(text "NOTES: (1) DRV8323S VM abs max 65 V, recommended 60 V. Do not add a TVS clamping above ~65 V on VBUS. (2) R310-R315 are slew-rate trim (2.2 R). (3) SPx/SNx = Kelvin sense pair from each shunt. (4) Firmware: copy hwconf/trampa/hd/hw_hd60.h, set CURRENT_SHUNT_RES 0.001, V limits 8..48."
		(exclude_from_sim no)
		(at 20 405 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "4df2fa05-b5a5-5525-9442-b60b198a0d92")
	)
	(text "Decoupling: one 100 nF per VDD pin (19/32/48/64) + VBAT; VDDA via ferrite; place at pins"
		(exclude_from_sim no)
		(at 30 112 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "4e0658ed-fbf9-5708-b537-7381b8b3eb7e")
	)
	(text "VM: 100nF + 10uF within 3 mm of pin 4; CPH-CPL 47nF rated VM; VCP-VM 1uF/25V"
		(exclude_from_sim no)
		(at 195 100 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6e8e7222-fbc7-59ae-96c1-8203610111bf")
	)
	(text "Divider ratio 18.7:1 (39k/2.2k) as hw_hd60: 42 V -> 2.2 V at the ADC. Place NT301 next to the FETs."
		(exclude_from_sim no)
		(at 290 318 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "2ffd7436-baf9-5e21-80db-7033e0ea3b17")
	)
	(text "E-stop: +3V3_DRV_EN is 3.3 V only while the E-stop loop is closed. ENABLE low => all gates off (coast). Fail-safe brakes are a separate output (main board)."
		(exclude_from_sim no)
		(at 140 395 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "b5db6a8a-d3d7-5adc-96d1-057e0eab52f9")
	)
