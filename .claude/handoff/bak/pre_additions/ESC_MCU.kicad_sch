	(text "Pin map = hwconf/stormcore/60D (HW_VER_IS_60D: CURRENT_AMP_GAIN 10, CURRENT_SHUNT_RES 0.001, VIN 39k/2.2k). Own hwconf: copy hw_stormcore_60d_core.*, drop the smart switch (HW_EARLY_INIT, SWITCH_*), NRF, IMU and RGB LED."
		(exclude_from_sim no)
		(at 20 28 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "de70c903-0b5c-5efe-87f0-9be437cb5f42")
	)
	(text "Motor 1 = TIM1 (PE8-PE13), CURR1-3 PB1/PB0/PC4, SENS1-3 PA2/PA0/PA1, halls PD13/PD12/PD14 (+ABI encoder option on TIM4), nSCS PC13, EN PE14, nFAULT PE3"
		(exclude_from_sim no)
		(at 20 34 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "9d02a6c5-5ff2-5713-a4a1-8c9c2f283510")
	)
	(text "Ex-ESP32 signals (ESP32 sheets removed 2026-10-24): PE5/PE6 = BRAKE1_EN/BRAKE2_EN (TIM9 CH1/CH2, brake PWM), PD10 = ESTOP_SENSE (in), PD8 = BUS_FLT_N (in), PA11/PA12 = USB D-/D+, PA9 = USB VBUS sense"
		(exclude_from_sim no)
		(at 20 46 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "48722012-e265-5053-ac9a-9e8c7c05d43d")
	)
	(text "Motor 2 = TIM8 (PC6-8, PA7, PB14, PB15), CURR4-6 PC5/PA6/PA5, SENS4-6 PC3/PC2/PC1, halls PB4/PB6/PB7, nSCS PD2, EN PD4, nFAULT PD3. Shared DRV SPI (bit-bang): SCK PC10, MISO PC11, MOSI PC12"
		(exclude_from_sim no)
		(at 20 40 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "fa2ea993-1f42-5feb-ab8a-74a8b26ca13e")
	)
	(text "Decoupling: 100 nF at each of the 6 VDD pins + VBAT, 4.7 uF bulk; VDDA/VREF+ via ferrite; VCAP 2.2 uF each"
		(exclude_from_sim no)
		(at 30 58 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "f2172cf6-2874-5d33-bc60-49cd956d82f6")
	)
	(text "HARDWARE E-STOP GATE (category 1 stop): Mx_ENABLE = MCU enable AND DRV_EN_DLY. E-stop -> PE15 (ESTOP_OK, immediate): firmware brakes; ~1.7 s later DRV_EN_DLY drops => all gates off (coast)."
		(exclude_from_sim no)
